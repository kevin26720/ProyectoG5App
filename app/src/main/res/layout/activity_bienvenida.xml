<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    tools:context=".BienvenidaActivity">

    <!-- Header Section -->
    <View
        android:id="@+id/viewHeaderBg"
        android:layout_width="410dp"
        android:layout_height="225dp"
        android:background="@drawable/header_login_bg"
        app:layout_constraintBottom_toBottomOf="@+id/tvSubtitle2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="318dp"
        android:layout_height="143dp"
        android:layout_marginTop="4dp"
        android:contentDescription="Logo Flagraphy"
        android:src="@drawable/logo_amarillo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/login_subtitle_1"
        android:textColor="@color/inicio_button_stroke"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo" />

    <TextView
        android:id="@+id/tvSubtitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/login_subtitle_2"
        android:textColor="@color/inicio_button_stroke"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle1" />

    <!-- Welcome Section -->

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="156dp"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:text="@string/welcome_greeting"
        android:textColor="@color/login_text_title"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewHeaderBg" />

    <!-- Buttons -->
    <TextView
        android:id="@+id/tvPlayerName"
        android:layout_width="218dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:text="@string/welcome_player_name_placeholder"
        android:textColor="@color/login_text_title"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWelcome" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/button_jugar_bg"
        android:drawableEnd="@drawable/ic_double_arrow"
        android:drawableTint="@color/inicio_button_stroke"
        android:paddingStart="48dp"
        android:paddingEnd="32dp"
        android:text="@string/login_btn_continue"
        android:textAllCaps="false"
        android:textColor="@color/inicio_button_stroke"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvPlayerName" />

    <!-- Footer Text -->

    <!-- Bottom Decorations -->

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNewGame"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/button_jugar_bg"
        android:text="@string/welcome_btn_new_game"
        android:textAllCaps="false"
        android:textColor="@color/inicio_button_stroke"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnContinue" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSettings"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/button_secondary_bg"
        android:drawableEnd="@drawable/ic_settings"
        android:drawableTint="@color/inicio_button_stroke"
        android:paddingStart="32dp"
        android:paddingEnd="16dp"
        android:text="@string/welcome_btn_settings"
        android:textAllCaps="false"
        android:textColor="@color/inicio_button_stroke"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnNewGame" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRanking"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/button_secondary_bg"
        android:drawableEnd="@drawable/ic_ranking"
        android:drawableTint="@color/inicio_button_stroke"
        android:paddingStart="32dp"
        android:paddingEnd="16dp"
        android:text="@string/welcome_btn_ranking"
        android:textAllCaps="false"
        android:textColor="@color/inicio_button_stroke"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSettings" />

    <ImageView
        android:id="@+id/ivNube"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="fitXY"
        android:src="@drawable/nube"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivGloboBottom"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginStart="-32dp"
        android:layout_marginBottom="-32dp"
        android:src="@drawable/globo_pantalla_inicio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivBuho"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginEnd="-16dp"
        android:layout_marginBottom="-16dp"
        android:src="@drawable/buho"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>